{
  "name": "@cobot/ts-shared",
  "version": "0.1.0",
  "description": "TypeScript-only shared domain types, frontend models, Result types, and common utilities for Cobot",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "check-types": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./frontend-types": {
      "types": "./src/frontend-types/index.ts",
      "import": "./src/frontend-types/index.ts",
      "default": "./src/frontend-types/index.ts"
    }
  },
  "dependencies": {}
}
